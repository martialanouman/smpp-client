# Échoue si la version de Node ne satisfait pas `engines` plutôt que de laisser
# une divergence silencieuse entre poste et CI.
engine-strict=true

# Les peer dependencies non satisfaites sont signalées, pas bloquantes :
# l'écosystème React/ESLint en produit régulièrement sans conséquence réelle.
strict-peer-dependencies=false
