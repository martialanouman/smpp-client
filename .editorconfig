# Shared editing conventions — guide §3.5.
# The values mirror the rustfmt and prettier defaults: this file aligns
# editors with the formatters, it does not define a competing style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html,yml,yaml,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a meaningful line break in Markdown: do not strip
# them.
trim_trailing_whitespace = false

[justfile]
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
